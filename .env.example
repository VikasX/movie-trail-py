# Copy to .env and generate a unique SECRET_KEY (see README).
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Copy the session pooler URI from Supabase's Connect dialog.
# URL-encode special characters in the password. This is a placeholder, not a credential.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
# Local HTTP development only: set DEBUG=True in your local .env.
# HTTPS redirects, secure cookies and HSTS default on when DEBUG=False.

# --- URL switching reference ---
# Uncomment the desired values and replace any existing active value for the same key.
# URL settings are used by OAuth, email links, pagination and public sharing.
# Local development (use localhost consistently for Google OAuth):
# FRONTEND_PUBLIC_ORIGIN=http://localhost:5173
# BACKEND_PUBLIC_ORIGIN=http://localhost:8000
# Derived Google callback (not a separate setting): http://localhost:8000/accounts/google/login/callback/
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# DEBUG=True
#
# Deployed Vercel applications (origins have no trailing slash or /api/docs):
# FRONTEND_PUBLIC_ORIGIN=https://movie-trail-ui.vercel.app
# BACKEND_PUBLIC_ORIGIN=https://movie-trail-py.vercel.app
# Derived Google callback (not a separate setting): https://movie-trail-py.vercel.app/accounts/google/login/callback/
# CORS_ALLOWED_ORIGINS=https://movie-trail-ui.vercel.app
# CSRF_TRUSTED_ORIGINS=https://movie-trail-ui.vercel.app
# ALLOWED_HOSTS=movie-trail-py.vercel.app
# DEBUG=False
# Register each exact callback URI in Google Console before using it.
# Separate vercel.app domains require the contract's same-origin proxy or custom
# same-site subdomains for reliable cookie login; origins alone do not solve this.
# With a same-origin UI proxy for BOTH /api/* and /accounts/*, use instead:
# BACKEND_PUBLIC_ORIGIN=https://movie-trail-ui.vercel.app
# Derived Google callback (not a separate setting): https://movie-trail-ui.vercel.app/accounts/google/login/callback/
# (Direct backend remains https://movie-trail-py.vercel.app as the proxy target.)
# Restart local Django after changes; Vercel environment changes require redeployment.

# External integrations (server-side only; never commit real values).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TMDB_READ_ACCESS_TOKEN=
# Used only when no bearer token is supplied:
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
# The backend rejects alternate TMDB hosts to keep credentials on the trusted API.
# Active local browser-facing origins. For Vercel proxy, use the UI origin for BOTH.
FRONTEND_PUBLIC_ORIGIN=http://localhost:5173
BACKEND_PUBLIC_ORIGIN=http://localhost:8000
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Preserve this key across deployments or existing encrypted share links cannot be recovered.
SHARE_TOKEN_ENCRYPTION_KEY=
# Local email: verification/reset URLs print to your own terminal only.
# Production: use SMTP (or a compatible installed delivery backend), never console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=cinescope@localhost
