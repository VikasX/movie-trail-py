# Copy to .env and generate a unique SECRET_KEY (see README).
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Copy the session pooler URI from Supabase's Connect dialog.
# URL-encode special characters in the password. This is a placeholder, not a credential.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
# Local HTTP development only: set DEBUG=True in your local .env.
# HTTPS redirects, secure cookies and HSTS default on when DEBUG=False.
